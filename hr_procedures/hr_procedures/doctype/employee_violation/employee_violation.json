{
  "doctype": "DocType",
  "name": "Employee Violation",
  "module": "HR Procedures",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_rename": 0,
  "index_web_pages_for_search": 0,
  "autoname": "format:HR-VIO-{YYYY}-{#####}",
  "title_field": "employee_name",
  "is_submittable": 1,
  "field_order": [
    "identity_section",
    "employee",
    "employee_name",
    "company",
    "department",
    "column_break_identity",
    "violation_date",
    "violation_type",
    "category",
    "source",
    "requires_hr_confirmation",
    "reference_section",
    "reference_doctype",
    "reference_name",
    "metrics_section",
    "late_minutes",
    "early_exit_minutes",
    "absence_days",
    "policy_section",
    "violation_policy",
    "occurrence_no",
    "penalty_tier",
    "deserved_penalty",
    "deserved_penalty_details",
    "deserved_deduction_amount",
    "decision_section",
    "penalty_decision",
    "alternative_penalty",
    "decision_reason",
    "decision_by",
    "decision_date",
    "final_section",
    "final_penalty",
    "final_deduction_amount",
    "execution_section",
    "execution_status",
    "additional_salary",
    "administrative_action",
    "notes_section",
    "remarks",
    "evidence"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "Violation"
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "fetch_from": "employee.employee_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "fetch_from": "employee.company"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department",
      "fetch_from": "employee.department",
      "read_only": 1
    },
    {
      "fieldname": "column_break_identity",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "violation_date",
      "fieldtype": "Date",
      "label": "Violation Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "violation_type",
      "fieldtype": "Link",
      "label": "Violation Type",
      "options": "HR Violation Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "fieldtype": "Data",
      "label": "Category",
      "fetch_from": "violation_type.category",
      "read_only": 1
    },
    {
      "fieldname": "source",
      "fieldtype": "Select",
      "label": "Source",
      "options": "Manual\nAutomatic",
      "default": "Manual",
      "reqd": 1,
      "read_only_depends_on": "eval:doc.source=='Automatic'"
    },
    {
      "fieldname": "requires_hr_confirmation",
      "fieldtype": "Check",
      "label": "Requires HR Confirmation",
      "read_only": 1
    },
    {
      "fieldname": "reference_section",
      "fieldtype": "Section Break",
      "label": "Source Reference",
      "collapsible": 1
    },
    {
      "fieldname": "reference_doctype",
      "fieldtype": "Link",
      "label": "Reference DocType",
      "options": "DocType",
      "read_only_depends_on": "eval:doc.source=='Automatic'"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Dynamic Link",
      "label": "Reference Name",
      "options": "reference_doctype",
      "read_only_depends_on": "eval:doc.source=='Automatic'"
    },
    {
      "fieldname": "metrics_section",
      "fieldtype": "Section Break",
      "label": "Violation Metrics",
      "collapsible": 1
    },
    {
      "fieldname": "late_minutes",
      "fieldtype": "Float",
      "label": "Late Minutes"
    },
    {
      "fieldname": "early_exit_minutes",
      "fieldtype": "Float",
      "label": "Early Exit Minutes"
    },
    {
      "fieldname": "absence_days",
      "fieldtype": "Float",
      "label": "Absence Days"
    },
    {
      "fieldname": "policy_section",
      "fieldtype": "Section Break",
      "label": "Deserved Penalty"
    },
    {
      "fieldname": "violation_policy",
      "fieldtype": "Link",
      "label": "Violation Policy",
      "options": "HR Violation Policy",
      "read_only": 1
    },
    {
      "fieldname": "occurrence_no",
      "fieldtype": "Int",
      "label": "Occurrence Number",
      "read_only": 1
    },
    {
      "fieldname": "penalty_tier",
      "fieldtype": "Int",
      "label": "Penalty Tier",
      "read_only": 1
    },
    {
      "fieldname": "deserved_penalty",
      "fieldtype": "Link",
      "label": "Deserved Penalty",
      "options": "HR Penalty Template",
      "read_only": 1
    },
    {
      "fieldname": "deserved_penalty_details",
      "fieldtype": "Small Text",
      "label": "Deserved Penalty Details",
      "read_only": 1
    },
    {
      "fieldname": "deserved_deduction_amount",
      "fieldtype": "Currency",
      "label": "Deserved Deduction Amount",
      "read_only": 1
    },
    {
      "fieldname": "decision_section",
      "fieldtype": "Section Break",
      "label": "Penalty Decision"
    },
    {
      "fieldname": "penalty_decision",
      "fieldtype": "Select",
      "label": "Penalty Decision",
      "reqd": 1,
      "options": "Execute Deserved Penalty\nWaive Penalty\nApply Alternative Penalty",
      "default": "Execute Deserved Penalty"
    },
    {
      "fieldname": "alternative_penalty",
      "fieldtype": "Link",
      "label": "Alternative Penalty",
      "options": "HR Penalty Template",
      "depends_on": "eval:doc.penalty_decision=='Apply Alternative Penalty'"
    },
    {
      "fieldname": "decision_reason",
      "fieldtype": "Small Text",
      "label": "Decision Reason"
    },
    {
      "fieldname": "decision_by",
      "fieldtype": "Link",
      "label": "Decision By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "decision_date",
      "fieldtype": "Datetime",
      "label": "Decision Date",
      "read_only": 1
    },
    {
      "fieldname": "final_section",
      "fieldtype": "Section Break",
      "label": "Final Penalty"
    },
    {
      "fieldname": "final_penalty",
      "fieldtype": "Link",
      "label": "Final Penalty",
      "options": "HR Penalty Template",
      "read_only": 1
    },
    {
      "fieldname": "final_deduction_amount",
      "fieldtype": "Currency",
      "label": "Final Deduction Amount",
      "read_only": 1
    },
    {
      "fieldname": "execution_section",
      "fieldtype": "Section Break",
      "label": "Execution"
    },
    {
      "fieldname": "execution_status",
      "fieldtype": "Select",
      "label": "Execution Status",
      "options": "Not Executed\nExecuted\nWaived\nPending Administrative Action\nNo Action",
      "default": "Not Executed",
      "read_only": 1
    },
    {
      "fieldname": "additional_salary",
      "fieldtype": "Link",
      "label": "Additional Salary",
      "options": "Additional Salary",
      "read_only": 1
    },
    {
      "fieldname": "administrative_action",
      "fieldtype": "Link",
      "label": "Administrative Action",
      "options": "HR Administrative Action",
      "read_only": 1
    },
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "Notes and Evidence"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Text",
      "label": "Remarks"
    },
    {
      "fieldname": "evidence",
      "fieldtype": "Attach",
      "label": "Evidence"
    }
  ],
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "HR User",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1
    }
  ]
}
